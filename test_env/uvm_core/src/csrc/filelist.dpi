DPI_STUB_OBJS_OBJ0=./../salida.daidir/vc_hdrs.o
DPI_STUB_OBJS_SRC0=./../salida.daidir/vc_hdrs.c
DPI_STUB_OBJS += $(DPI_STUB_OBJS_OBJ0)
$(DPI_STUB_OBJS_OBJ0): $(DPI_STUB_OBJS_SRC0)
	@$(CC) -I/mnt/vol_synopsys2023/synopsys/vcs/U-2023.03-SP2/include  -pipe -DVCSMX -DUVM_DPI_DO_TYPE_CHECK -DVCS    -I/mnt/vol_synopsys2023/synopsys/vcs/U-2023.03-SP2/include  -fPIC -c -o $(DPI_STUB_OBJS_OBJ0) $(DPI_STUB_OBJS_SRC0)
	@strip -g $(DPI_STUB_OBJS_OBJ0)
