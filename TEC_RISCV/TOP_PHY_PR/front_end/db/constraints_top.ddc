###################################################################

# Created by write_sdc on Wed Mar 27 15:32:28 2019

###################################################################
set sdc_version 2.0

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current uA
set_operating_conditions TYPICAL -library D_CELLS_HDLL_LPMOS_typ_1_80V_25C
create_clock [get_ports clk_pad]  -name CLK  -period 50  -waveform {0 25}
set_clock_uncertainty 0.1  [get_clocks CLK]
set_clock_transition -max -rise 0.05 [get_clocks CLK]
set_clock_transition -max -fall 0.05 [get_clocks CLK]
set_clock_transition -min -rise 0.05 [get_clocks CLK]
set_clock_transition -min -fall 0.05 [get_clocks CLK]
set_operating_conditions -max TYPICAL -max_library                             \
D_CELLS_HDLL_LPMOS_typ_1_80V_25C.db:D_CELLS_HDLL_LPMOS_typ_1_80V_25C -min      \
TYPICAL -min_library                                                           \
D_CELLS_HDLL_LPMOS_typ_1_80V_25C.db:D_CELLS_HDLL_LPMOS_typ_1_80V_25C           \
-object_list [get_cells top_riscv_soc]
