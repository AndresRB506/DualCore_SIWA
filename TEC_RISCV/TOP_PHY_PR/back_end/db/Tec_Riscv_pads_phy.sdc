set sdc_version 2.0

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current uA
set_operating_conditions TYPICAL -library D_CELLS_HDLL_LPMOS_typ_1_80V_25C
set_propagated_clock [get_ports clk_pad]
create_voltage_area -name pad_ring_inst/PD_PADS  -coordinate {0 1353 1338 1520 0 167 167 1353 0 0 1353 167}  -guard_band_x 0  -guard_band_y 0  [get_cells pad_ring_inst]
create_voltage_area -name top_riscv_soc/TOP/PD_SRAM  -coordinate {189.42 586.485 913.1 1330.65}  -guard_band_x 0  -guard_band_y 0  [get_cells top_riscv_soc/TOP/Memoria_8K]
create_voltage_area -name top_riscv_soc/PD_CORE  -coordinate {918.1 584.485 1465.66 1330.93 189.42 188.525 1465.66 584.485}  -guard_band_x 0  -guard_band_y 0  [list [get_cells top_riscv_soc/DHC_PD_CORE] [get_cells top_riscv_soc/TOP]     \
[get_cells top_riscv_soc/SPI] [get_cells top_riscv_soc/UART]]
create_clock [get_ports clk_pad]  -name CLK  -period 50  -waveform {0 25}
set_clock_uncertainty 0.1  [get_clocks CLK]
set_operating_conditions -max TYPICAL -max_library                             \
D_CELLS_HDLL_LPMOS_typ_1_80V_25C.db:D_CELLS_HDLL_LPMOS_typ_1_80V_25C -min      \
TYPICAL -min_library                                                           \
D_CELLS_HDLL_LPMOS_typ_1_80V_25C.db:D_CELLS_HDLL_LPMOS_typ_1_80V_25C           \
-object_list [get_cells top_riscv_soc]
set_voltage 1.8  -min 1.8  -object_list VDD_1V8
set_voltage 1.8  -min 1.8  -object_list VDD_1V8SRAM
set_voltage 3.3  -min 3.3  -object_list VDD_3V3_PADS
set_voltage 0  -min 0  -object_list VSS
set_voltage 3.3  -min 3.3  -object_list pad_ring_inst/VDD_3V3_PADS
set_voltage 1.8  -min 1.8  -object_list pad_ring_inst/VDD_1V8_PADS
set_voltage 0  -min 0  -object_list pad_ring_inst/VSS
