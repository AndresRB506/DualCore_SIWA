set_max_capacitance 0.09887 [get_ports {gpio_pad[1]}]
set_max_capacitance 0.09887 [get_ports {gpio_pad[0]}]
set_max_transition 1.42597 [get_ports reset_pad]
set_max_transition 1.42597 [get_ports MISO_pad]
set_max_transition 1.42597 [get_ports RX_UART_pad]
set_max_transition 1.42597 [get_ports maip_pad]
set_max_transition 1.42597 [get_ports MOSI_pad]
set_max_transition 1.42597 [get_ports SCLK_pad]
set_max_transition 1.42597 [get_ports SCS_pad]
set_max_transition 1.42597 [get_ports TX_UART_pad]
set_max_transition 1.42597 [get_ports {gpio_pad[7]}]
set_max_transition 1.42597 [get_ports {gpio_pad[6]}]
set_max_transition 1.42597 [get_ports {gpio_pad[5]}]
set_max_transition 1.42597 [get_ports {gpio_pad[4]}]
set_max_transition 1.42597 [get_ports {gpio_pad[3]}]
set_max_transition 1.42597 [get_ports {gpio_pad[2]}]
set_max_transition 1.42597 [get_ports {gpio_pad[1]}]
set_max_transition 1.42597 [get_ports {gpio_pad[0]}]
create_clock [get_ports clk_pad]  -name CLK  -period 50  -waveform {0 25}
set_clock_latency 1  [get_clocks CLK]
set_clock_uncertainty 0.1  [get_clocks CLK]
set_clock_transition -min -fall 0.05 [get_clocks CLK]
set_clock_transition -min -rise 0.05 [get_clocks CLK]
set_clock_transition -max -fall 0.05 [get_clocks CLK]
set_clock_transition -max -rise 0.05 [get_clocks CLK]
set_input_delay -clock CLK  -max 20  [get_ports reset_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports reset_pad]
set_input_delay -clock CLK  -max 20  [get_ports MISO_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports MISO_pad]
set_input_delay -clock CLK  -max 20  [get_ports RX_UART_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports RX_UART_pad]
set_input_delay -clock CLK  -max 20  [get_ports maip_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports maip_pad]
set_input_delay -clock CLK  -max 20  [get_ports MOSI_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports MOSI_pad]
set_input_delay -clock CLK  -max 20  [get_ports SCLK_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports SCLK_pad]
set_input_delay -clock CLK  -max 20  [get_ports SCS_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports SCS_pad]
set_input_delay -clock CLK  -max 20  [get_ports TX_UART_pad]
set_input_delay -clock CLK  -min 0.1  [get_ports TX_UART_pad]
