set_input_delay -clock CLK  -min 0.1  [get_ports {gpio_pad[5]}]
set_input_delay -clock CLK  -max 20  [get_ports {gpio_pad[4]}]
set_input_delay -clock CLK  -min 0.1  [get_ports {gpio_pad[4]}]
set_input_delay -clock CLK  -max 20  [get_ports {gpio_pad[3]}]
set_input_delay -clock CLK  -min 0.1  [get_ports {gpio_pad[3]}]
set_input_delay -clock CLK  -max 20  [get_ports {gpio_pad[2]}]
set_input_delay -clock CLK  -min 0.1  [get_ports {gpio_pad[2]}]
set_input_delay -clock CLK  -max 20  [get_ports {gpio_pad[1]}]
set_input_delay -clock CLK  -min 0.1  [get_ports {gpio_pad[1]}]
set_input_delay -clock CLK  -max 20  [get_ports {gpio_pad[0]}]
set_input_delay -clock CLK  -min 0.1  [get_ports {gpio_pad[0]}]
set_output_delay -clock CLK  -max 20  [get_ports MOSI_pad]
set_output_delay -clock CLK  -min -0.1  [get_ports MOSI_pad]
set_output_delay -clock CLK  -max 20  [get_ports SCLK_pad]
set_output_delay -clock CLK  -min -0.1  [get_ports SCLK_pad]
